            if marked:
                assert d.json_result(d.observer.query(v2.marker_sql(f['mark'])))['status'] == 'marked'
            assert d.json_result(d.observer.query(v2.revoke_sql(f, kind)))['revoked']
            if not marked:
                assert d.json_result(d.observer.query(v2.marker_sql(f['mark'])))['status'] == 'denied'
            d.consumed_exact_proof(f)
            d.check_closed(f, marked=marked, charged=True)
    for close_first in (False, True):
