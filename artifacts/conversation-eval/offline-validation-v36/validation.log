const assert = require('node:assert/strict');
const fs = require('node:fs');
const path = require('node:path');
const Module = require('node:module');
const { createHash } = require('node:crypto');
const root = '/workspace/scratch/500c5aa1eb33/v36/repo';
const output = '/workspace/scratch/500c5aa1eb33/v36/voice-initial';
const filename = path.join(root, 'scripts/conversation-ui/check-voice-controls.cjs');
const source = fs.readFileSync(filename, 'utf8');
const ending = source.lastIndexOf('\nmain().catch(');
assert.ok(ending > 0, 'Expected exact existing main invocation');
process.chdir(root);
process.argv[2] = output;
const loaded = new Module(filename, module);
loaded.filename = filename;
loaded.paths = Module._nodeModulePaths(path.dirname(filename));
loaded._compile(source.slice(0, ending) + '\nmodule.exports = { bundle };\n', filename);
(async () => {
 const html = await loaded.exports.bundle();
 assert.ok(html.startsWith('<!doctype html>'));
 assert.ok(html.includes('Offline UI fixture. All voice resources and replies are fictional.'));
 assert.ok(html.includes('Retry shutdown') && html.includes('Finish talking'));
 assert.ok(html.includes('voiceHarness') && html.includes('FICTIONAL_LATE_REPLY'));
 const css = fs.readFileSync(process.env.BFA_UI_CSS, 'utf8');
 assert.ok(css.length > 1000 && html.includes(css));
 const result = {
  status: 'BUNDLE_VALIDATED_BROWSER_UNRUN',
  sourceSha256: createHash('sha256').update(source).digest('hex'),
  productionCss: { path: process.env.BFA_UI_CSS, sha256: createHash('sha256').update(css).digest('hex'), bytes: Buffer.byteLength(css) },
  generatedHtml: { bytes: Buffer.byteLength(html), sha256: createHash('sha256').update(html).digest('hex') },
  actualBundleFunction: true, browserLaunched: false,
  accessibilityModesExecuted: 0, lifecycleBrowserChecksExecuted: 0,
  realMicrophoneCalls: 0, realProviderCalls: 0,
  limitation: 'Only actual esbuild/CSS composition validated; no DOM, computed media, keyboard, layout, focus or screenshot observation occurred.'
 };
 fs.writeFileSync(path.join(output, 'bundle-validation.json'), JSON.stringify(result, null, 2) + '\n');
 console.log(JSON.stringify(result, null, 2));
})().catch(error => { console.error(error); process.exitCode = 1; });
