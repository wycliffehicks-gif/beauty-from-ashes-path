class Observer:
    def query(self, sql):
        print(json.dumps({'sql': sql}), flush=True)
        response = json.loads(input())
        if 'error' in response:
            raise RuntimeError(response['error'])
        return response['lines']
    def scalar(self, sql):
        rows = self.query(sql)
        assert len(rows) == 1, rows
        return rows[0]
