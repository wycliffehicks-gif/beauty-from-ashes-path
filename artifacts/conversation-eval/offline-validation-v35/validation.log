import { PGlite } from '/workspace/scratch/205dbad31641/p5-sql-work/environment/node_modules/@electric-sql/pglite/dist/index.js';
import { readFile } from 'node:fs/promises';
import { spawn, execFileSync } from 'node:child_process';
import { createInterface } from 'node:readline';
const root='/workspace/scratch/500c5aa1eb33/v35/repo';
let seed, db, child;
let queries=0, expectedErrors=0, complete=false;
try {
 seed=await PGlite.create();
 await seed.exec('CREATE DATABASE bfa_p5_offline_fixture;');
 const bundle=await seed.dumpDataDir('none'); await seed.close();
 db=await PGlite.create({loadDataDir:bundle,database:'bfa_p5_offline_fixture'});
 await db.exec('CREATE ROLE bfa_fixture_admin SUPERUSER LOGIN; SET SESSION AUTHORIZATION bfa_fixture_admin;');
 const install=async(file)=>db.exec(await readFile(root+'/'+file,'utf8'));
 await install('scripts/conversation-eval/p5-sql/bootstrap.sql');
 const inventories=JSON.parse(execFileSync('python',['-I','-c',
  "import ast,json,sys; from pathlib import Path; tree=ast.parse(Path(sys.argv[1]).read_text()); names={n.targets[0].id:ast.literal_eval(n.value) for n in tree.body if isinstance(n,ast.Assign) and len(n.targets)==1 and isinstance(n.targets[0],ast.Name) and n.targets[0].id in ('MIGRATIONS','V2_DRAFTS')}; print(json.dumps(names))",
  root+'/scripts/conversation-eval/p5-sql/run-local.py'],{encoding:'utf8',env:{PATH:process.env.PATH,LANG:'C.UTF-8'}}));
 if(inventories.MIGRATIONS.length!==6||inventories.V2_DRAFTS.length!==11)throw new Error('Exact runner inventory unavailable');
 for(const name of inventories.MIGRATIONS) await install('drizzle/migrations/'+name);
 for(const name of ['p5-voice-admission.sql','p5-voice-capacity.sql',...inventories.V2_DRAFTS]) await install('docs/pilot/conversation/sql-drafts/'+name);
 console.log(JSON.stringify({exactRunnerDraftOrder:['p5-voice-admission.sql','p5-voice-capacity.sql',...inventories.V2_DRAFTS]}));
 child=spawn('python',['-I','/workspace/scratch/500c5aa1eb33/v35/native-fixture-smoke.py'],{stdio:['pipe','pipe','pipe'],env:{PATH:process.env.PATH,LANG:'C.UTF-8'},cwd:'/workspace/scratch/500c5aa1eb33/v35'});
 let errors=''; child.stderr.on('data',d=>errors+=d);
 const ended=new Promise(resolve=>child.on('close',code=>resolve(code)));
 for await(const line of createInterface({input:child.stdout})){
  const request=JSON.parse(line);
  if(request.done){console.log(JSON.stringify(request.done));complete=true;continue;}
  queries++;
  try {
   const results=await db.exec(request.sql);
   const lines=results.flatMap(r=>r.rows.flatMap(row=>Object.values(row).map(value=>value===null?'':typeof value==='boolean'?value?'t':'f':typeof value==='object'?JSON.stringify(value):String(value)))).filter(Boolean);
   child.stdin.write(JSON.stringify({lines})+'\n');
  }catch(error){expectedErrors++;child.stdin.write(JSON.stringify({error:error.message})+'\n');}
 }
 const code=await ended;
 if(code!==0||!complete)throw new Error('Sequential smoke failed: '+errors);
 console.log(JSON.stringify({queries,expectedErrors,seedClosed:seed.closed,nativeCasesExecuted:0}));
}finally{
 if(child&&child.exitCode===null)child.kill();
 if(db&&!db.closed)await db.close();
 if(seed&&!seed.closed)await seed.close();
 console.log(JSON.stringify({allEnginesClosed:(!db||db.closed)&&(!seed||seed.closed)}));
