// Diagnostic only: runs unchanged application store/service with canned local
// provider. No browser, HTTP, Auth, persistence, model or voice resources.
const path = require('node:path');
const Module = require('node:module');
const root = process.argv[2] || '/workspace/scratch/500c5aa1eb33/v36/repo';
const esbuild = Module.createRequire(path.join(root, 'package.json'))('esbuild');
process.chdir(root);
const source = `
import assert from 'node:assert/strict';
import { ConversationPreviewStore } from '${root}/src/lib/ai/conversation/preview/store';
import { ConversationService } from '${root}/src/lib/ai/conversation/service/service';
import { createMockProvider } from '${root}/src/lib/ai/conversation/service/mock-provider';
(async () => {
  const queue = []; let dispatches = 0;
  const service = new ConversationService({ provider: createMockProvider({ delayMs: 0, onDispatch: () => dispatches++ }) });
  await service.ready();
  const store = new ConversationPreviewStore({ service, schedule: fn => { queue.push(fn); return queue.length; }, nowIso: () => '2026-11-06T12:00:00.000Z' });
  // Existing node test harness uses the same browser-init replacement.
  store.ensureBrowserInit = () => {};
  const original = store.createThread();
  store.setDraft('SYNTHETIC_NEVER_SAVED_DISCARD_CANARY');
  assert.deepEqual(store.sendDraft(), { ok: true });
  for (let i = 0; i < 40; i++) {
    while (queue.length) queue.shift()();
    await new Promise(resolve => setTimeout(resolve, 1));
  }
  assert.equal(dispatches, 1);
  assert.equal(store.hasPendingResponse(store.activeThread()), false);
  const before = { saved: store.activeThread().savedSnapshot !== null, messages: store.activeThread().messages.length, serviceEvents: service.inspect(original.id).events.length };
  const requested = store.requestSwitch({ kind: 'new' });
  assert.deepEqual(requested, { ok: false, reason: 'needs-decision' });
  const decision = store.resolveSwitchDecision('discard');
  assert.deepEqual(decision, { ok: true });
  const retained = store.getSnapshot().threads.find(thread => thread.id === original.id);
  const after = { retainedThread: !!retained, retainedMessages: retained?.messages.length ?? 0, serviceStillHasThread: service.hasThread(original.id), serviceRetainsCanary: JSON.stringify(service.inspect(original.id)).includes('SYNTHETIC_NEVER_SAVED_DISCARD_CANARY') };
  const reopened = store.requestSwitch({ kind: 'open', threadId: original.id });
  const reopenedUiRetainsCanary = JSON.stringify(store.activeThread()).includes('SYNTHETIC_NEVER_SAVED_DISCARD_CANARY');
  console.log(JSON.stringify({ scope: 'Unchanged actual preview store + shared service; local canned provider only', before, requested, decision, after, reopened, reopenedUiRetainsCanary, mockDispatches: dispatches, browserCalls: 0, networkCalls: 0 }, null, 2));
  // These diagnostic assertions describe the reproduced defect, not desired behavior.
  assert.deepEqual(after, { retainedThread: true, retainedMessages: 2, serviceStillHasThread: true, serviceRetainsCanary: true });
  assert.deepEqual(reopened, { ok: true });
  assert.equal(reopenedUiRetainsCanary, true);
})().catch(error => { console.error(error); process.exitCode = 1; });
`;
esbuild.build({ stdin: { contents: source, loader: 'ts', resolveDir: root }, bundle: true, platform: 'node', format: 'cjs', write: false, alias: { '@': path.join(root, 'src') } })
  .then(result => {
    const filename = path.join(root, 'triage-reproduction.cjs');
    const unit = new Module(filename, module);
    unit.filename = filename;
    unit.paths = Module._nodeModulePaths(root);
    unit._compile(result.outputFiles[0].text, filename);
  })
  .catch(error => { console.error(error); process.exitCode = 1; });

