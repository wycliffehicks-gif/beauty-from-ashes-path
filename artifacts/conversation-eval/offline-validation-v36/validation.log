=== review-bundle-check.cjs ===
// Independent compile-only check. Existing harness functions are invoked in
// memory; their main entry points and every browser launch are blocked.
const assert = require('node:assert/strict');
const fs = require('node:fs');
const path = require('node:path');
const Module = require('node:module');
const vm = require('node:vm');
const {createHash} = require('node:crypto');

const root = '/workspace/scratch/500c5aa1eb33/v36/repo';
const out = '/workspace/scratch/500c5aa1eb33/v36/independent-bundle';
const cssPath = path.join(root, '.output/public/assets/styles-DuOMzkts.css');
const runtime = '/opt/codex/runtimes/codex-primary-runtime/dependencies/node/node_modules/playwright';
const names = process.argv.slice(2);
assert.ok(names.length > 0);
assert.ok(names.every(name => ['check-focus.cjs','check-voice-controls.cjs'].includes(name)));
fs.mkdirSync(out, {recursive:true});
process.chdir(root);
process.env.BFA_PLAYWRIGHT_MODULE = runtime;
process.env.BFA_UI_CSS = cssPath;
const hash = value => createHash('sha256').update(value).digest('hex');
const css = fs.readFileSync(cssPath, 'utf8');
assert.ok(css.length > 100000);
let launches = 0;
function load(name, stylesheet) {
  const filename = path.join(root, 'scripts/conversation-ui', name);
  const source = fs.readFileSync(filename, 'utf8');
  const tail = source.lastIndexOf('\nmain().catch(');
  assert.ok(tail > 0, 'Expected existing main entry point');
  assert.match(source.slice(tail), /^\nmain\(\)\.catch\(\(error\) => \{\s*console\.error\(error\);\s*process\.exitCode = 1;\s*\}\);\s*$/);
  const unit = new Module(filename, module);
  unit.filename = filename;
  unit.paths = Module._nodeModulePaths(path.dirname(filename));
  const normalRequire = unit.require.bind(unit);
  unit.require = request => {
    if (request !== runtime) return normalRequire(request);
    const actual = normalRequire(request);
    return {...actual, chromium: new Proxy(actual.chromium, {get(target, key) {
      if (key === 'launch') return () => { launches++; throw Error('Browser launch forbidden in compile-only review'); };
      return Reflect.get(target, key);
    }})};
  };
  process.env.BFA_UI_CSS = stylesheet;
  process.argv = [process.execPath, filename, path.join(out, name.replace('.cjs',''))];
  unit._compile(source.slice(0,tail)+'\nmodule.exports = {bundle, main};\n', filename);
  return {source, exports:unit.exports};
}
async function run() {
  const results=[];
  const cssGuards=[];
  const emptyCss=path.join(out,'empty.css');
  fs.writeFileSync(emptyCss,'');
  for(const name of names) {
    const unit=load(name,cssPath);
    const variants=name==='check-focus.cjs'?['preview','staging']:['voice'];
    for(const variant of variants) {
      const html=await unit.exports.bundle(variant);
      assert.ok(html.startsWith('<!doctype html>'));
      assert.ok(html.includes(css));
      assert.ok(html.includes('name="viewport"'));
      const script=html.slice(html.indexOf('<script>')+8,html.lastIndexOf('</script>'));
      assert.ok(script.length>100000);
      new vm.Script(script,{filename:name+':'+variant+':compiled'});
      results.push({source:name,variant,sourceSha256:hash(unit.source),htmlBytes:Buffer.byteLength(html),htmlSha256:hash(html),scriptSyntax:'passed'});
    }
    // Actual module/main guards reject missing and empty CSS before launch.
    for(const [kind,stylesheet] of [['missing',''],['empty',emptyCss]]) {
      let missing, rejectedAtLoad=false;
      try { missing=load(name,stylesheet); }
      catch(error) { assert.match(String(error),/BFA_UI_CSS|production CSS must not be empty/); rejectedAtLoad=true; }
      if(!rejectedAtLoad) await assert.rejects(missing.exports.main(),/BFA_UI_CSS|production CSS must not be empty/);
      cssGuards.push({source:name,kind,status:'rejected-before-browser'});
    }
  }
  assert.equal(launches,0);
  const report={status:'passed',scope:'Actual existing esbuild bundle functions and missing/empty-CSS guards only; no browser or rendering execution',bundles:results,cssGuards,productionCss:{path:cssPath,bytes:Buffer.byteLength(css),sha256:hash(css)},browserLaunches:launches,browserChecksExecuted:0};
  fs.writeFileSync(path.join(out,'result.json'),JSON.stringify(report,null,2)+'\n');
  console.log(JSON.stringify(report,null,2));
}
run().catch(error=>{console.error(error);process.exitCode=1});

